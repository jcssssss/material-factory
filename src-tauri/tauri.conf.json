{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "小红书素材工厂",
  "version": "0.1.3",
  "identifier": "com.xhspic.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ./frontend run dev",
    "beforeBuildCommand": "npm --prefix ./frontend run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "小红书素材工厂",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "scope": ["$APPDATA/backgrounds/files/**"]
      },
      "capabilities": [
        {
          "identifier": "default",
          "description": "主窗口默认能力集合",
          "windows": ["main"],
          "permissions": ["core:default", "dialog:default"]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["../vendor/libreoffice"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "桌面批量 PDF 转小红书素材",
    "longDescription": "完全本地执行的桌面应用，按任务批量处理 PDF 并导出 3:4 竖版、300 DPI、JPG 质量 100% 的小红书素材图片。",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
